# ── Data: the irreplaceable asset lives outside git ──────────────────────────
# Never commit anything under data/ except data/sample/ (see AGENTS.md).
data/*
!data/sample/
!data/sample/**
!data/reference/
!data/reference/**
# Exception (2026-09-03, scrapers lab handover): the German BA partitions are
# carried to the main project as compressed archives, because this worktree is
# removed after the merge and data/raw is otherwise untracked. Archives only —
# never un-ignore data/raw itself. See PANEL_HANDOVER.md section 8.
!data/handover/
!data/handover/**

# ── Warehouses / local state ─────────────────────────────────────────────────
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3

# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
.dlt/secrets.toml
secrets.toml

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# ── dbt ──────────────────────────────────────────────────────────────────────
transform/target/
transform/dbt_packages/
transform/logs/
transform/.user.yml
# A dbt call without --project-dir writes here; never commit it.
logs/

# ── dlt ──────────────────────────────────────────────────────────────────────
.dlt/pipelines/
load/

# ── Evidence.dev / node ──────────────────────────────────────────────────────
node_modules/
site/.evidence/template/
site/.evidence-queries/
site/build/

# ── Models / caches too large for git ────────────────────────────────────────
.cache/
models_cache/
*.onnx
*.safetensors

# ── OS / editor ──────────────────────────────────────────────────────────────
.kilo/
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

